{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dystopia-merch",
    "main": "./worker/index.ts",
	"compatibility_date": "2026-08-07",
    "vars": {
        "PUBLIC_BASE_URL": "https://dystopiahungary.com",
        "CF_ACCESS_TEAM_DOMAIN": "https://aged-term-6a8f.cloudflareaccess.com",
        "CF_ACCESS_AUD": "6a6491c2e68a071524804c6f2f3b071ebade549a6c7ad064998aa01f0cd96f90",
        "ADMIN_ALLOWED_EMAILS": "blanar.levente@gmail.com,dystopiahungary@gmail.com"
    },
    "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
        "/api/*",
        "/assets/*.mp4"
    ]
    },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dystopia-merch-db",
			"database_id": "aa4d699b-6bc3-4639-8dde-97b241b7477f"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "dystopia-merch-images",
			"binding": "dystopia_merch_images"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}